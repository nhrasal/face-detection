# --- BIOMETRIC DATA — never commit ------------------------------------------
# These directories hold face images. Once a face photo enters git history it
# is effectively permanent and un-erasable. This block exists from the first
# commit deliberately; it is the only cheap moment to get it right.
backend/calibration/data/
backend/tests/assets/*
!backend/tests/assets/.gitkeep

# --- model weights (fetched by backend/scripts/download_models.sh) -------------------
# Not committed: ~40MB for the default pair, and the opt-in buffalo_l weights
# are non-commercial-research licensed and must not live in a distributable
# artifact.
#
# Note `backend/models/*` and not `backend/models/` — git cannot re-include a file whose parent
# directory is excluded, so a bare `backend/models/` would make the .gitkeep negation
# below silently dead.
backend/models/*
!backend/models/.gitkeep

# --- python ------------------------------------------------------------------
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- node --------------------------------------------------------------------
web/node_modules/
web/build/
web/dist/

# --- env ---------------------------------------------------------------------
.env
*.env
!.env.example
!web/environments/.env.local
!web/environments/.env.dev
!web/environments/.env.prod

# --- local data --------------------------------------------------------------
data/
uploads/
docs/calibration/*.png

.DS_Store
