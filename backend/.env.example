# Copy to backend/.env for local runs. Every value mirrors a field on
# app.core.config.Settings; anything omitted falls back to the default there.

# --- runtime ---------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3320"]

# --- persistence -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://face:face@localhost:55432/face_verification
# REDIS_URL=redis://localhost:63790/0

# --- face engine -----------------------------------------------------------
# opencv_zoo = YuNet + SFace, Apache-2.0, the shippable default.
# insightface = SCRFD + ArcFace, higher accuracy, NON-COMMERCIAL weights.
# fake        = deterministic test double. Rejected at startup when ENV=prod.
FACE_ENGINE=opencv_zoo
MODEL_DIR=./models
ALLOW_NONCOMMERCIAL_MODELS=false
INFERENCE_WORKERS=2
DETECT_MAX_SIDE=1280

# --- decision --------------------------------------------------------------
# Leave MATCH_THRESHOLD unset until the calibration phase has been run; the
# engine's own default is used meanwhile (SFace 0.363, ArcFace ~0.40 cosine).
#
# NB the roadmap's 0.72 is NOT a valid threshold for either model — genuine
# pairs cluster around 0.4-0.8 cosine, so 0.72 rejects most true matches.
# The shipped value must come from docs/THRESHOLD_CALIBRATION.md.
# MATCH_THRESHOLD=0.363
REVIEW_MARGIN=0.0
THRESHOLD_VERSION=sface-2021dec-default

# --- upload limits ---------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=11534336
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE=8000
MAX_FRAME_BYTES=1048576
RATE_LIMIT_COMPARE=10/minute
RATE_LIMIT_DETECT=30/minute
# Live camera preview samples 2-5 FPS; this is the ceiling for /face/detect/frame.
RATE_LIMIT_DETECT_FRAME=240/minute
# Concurrent WebSocket camera streams. Each one occupies an inference worker per
# frame, so raise this only alongside INFERENCE_WORKERS.
MAX_STREAM_SESSIONS=4

# --- storage / retention ---------------------------------------------------
# V1 keeps no candidate images — scores and metadata only.
STORE_UPLOADS=false
UPLOAD_DIR=./data/uploads
VERIFICATION_RETENTION_DAYS=180
